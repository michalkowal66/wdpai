-- 6. Przypisanie cech do biurek
INSERT INTO desk_features (desk_id, feature_id)
SELECT d.id, f.id FROM desks d, features f WHERE d.identifier = '101' AND f.name IN ('Near Window', 'Quiet Zone');

INSERT INTO desk_features (desk_id, feature_id)
SELECT d.id, f.id FROM desks d, features f WHERE d.identifier = '104' AND f.name IN ('Dual Monitor', 'Power Outlet');

INSERT INTO desk_features (desk_id, feature_id)
SELECT d.id, f.id FROM desks d, features f WHERE d.identifier = '111' AND f.name IN ('Adjustable Desk', 'Strong WiFi');

INSERT INTO desk_features (desk_id, feature_id)
SELECT d.id, f.id FROM desks d, features f WHERE d.identifier = '201' AND f.name IN ('Near Window', 'Dual Monitor', 'Power Outlet');

-- 7. Historyczne Rezerwacje (Bookings) - Dynamiczne w czasie za pomocą CURRENT_DATE

-- Wyłączenie wyzwalacza blokującego przeszłe rezerwacje na czas seedowania bazy
ALTER TABLE bookings DISABLE TRIGGER trigger_check_booking_date;

